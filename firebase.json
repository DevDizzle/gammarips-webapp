{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": {
    "source": "Echo-Trigger/functions",
    "runtime": "nodejs20"
  },
  "apphosting": {
    "project": {
      "auth": {
        "authorizedDomains": [
          "{{ hosting.sites.Default.domains.live }}",
          "{{ hosting.sites.Default.domains.preview }}"
        ]
      }
    }
  }
}