
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can be read by anyone, but only the user can write their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tickers can be read by any user
    match /tickers/{tickerId} {
      allow read: if request.auth != null;
      allow write: if false; // Should only be written by admin/backend processes
    }
    
    // Feedback can be created by any authenticated user.
    // They cannot read, update, or delete feedback.
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null;
    }
  }
}
