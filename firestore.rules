
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to submit feedback, but no one to read, update or delete it from the client.
    // This provides a secure "write-only" endpoint for the contact form.
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if true;
    }

    // Allow authenticated users to submit a survey response for themselves,
    // but not read, update, or delete any responses.
    match /feedback_surveys/{surveyId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // MCP API keys are server-only (Admin SDK). No client may read or write —
    // the doc id is a key hash and the collection is the auth source of truth
    // for the paid MCP. Explicit here (also covered by the default-deny below)
    // so it can never be loosened by accident.
    match /mcp_api_keys/{keyHash} {
      allow read, write: if false;
    }

    // Default deny all other collections for security.
    // We can add specific rules for other collections like 'users' later if needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
