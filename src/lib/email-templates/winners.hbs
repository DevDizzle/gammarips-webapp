
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; background-color: #0F172A; color: #E2E8F0; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { text-align: center; border-bottom: 1px solid #334155; padding-bottom: 20px; }
        .header h1 { color: #A855F7; margin: 0; font-size: 28px; }
        .content { padding: 20px 0; }
        .content h2 { font-size: 20px; color: #F8FAFC; margin-top: 0; }
        .winner-card { background-color: #1E293B; border: 1px solid #334155; border-radius: 8px; margin-bottom: 15px; padding: 15px; display: flex; align-items: center; gap: 15px; }
        .winner-logo { flex-shrink: 0; }
        .winner-logo img { width: 48px; height: 48px; border-radius: 50%; }
        .winner-info { flex-grow: 1; }
        .winner-info h3 { margin: 0; font-size: 18px; color: #F8FAFC; }
        .winner-info p { margin: 4px 0 0; color: #94A3B8; font-size: 14px; }
        .winner-outlook { text-align: right; }
        .winner-outlook .signal { font-weight: bold; font-size: 16px; }
        .outlook-bullish { color: #22C55E; }
        .outlook-bearish { color: #EF4444; }
        .winner-outlook .price { font-size: 14px; color: #94A3B8; margin-top: 4px; }
        .cta-button { display: inline-block; background-color: #A855F7; color: #0F172A; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 20px; }
        .footer { text-align: center; padding-top: 20px; border-top: 1px solid #334155; font-size: 12px; color: #64748B; }
        .footer a { color: #94A3B8; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>ProfitScout</h1>
            <p style="margin: 5px 0 0; color: #94A3B8;">Your Daily AI-Powered Setups</p>
        </div>

        <div class="content">
            <h2>Today's Top 5 Setups for {{date}}</h2>
            
            {{#if hasWinners}}
                {{#each winners}}
                <div class="winner-card">
                    <div class="winner-logo">
                        <img src="{{this.logoUrl}}" alt="{{this.company_name}} Logo">
                    </div>
                    <div class="winner-info">
                        <h3>{{this.company_name}} ({{this.ticker}})</h3>
                        <p>{{this.industry}}</p>
                        <a href="{{this.dashboardUrl}}" style="font-size: 13px; color: #A855F7; text-decoration: none;">View Dashboard &rarr;</a>
                    </div>
                    <div class="winner-outlook">
                        <div class="signal {{#if this.outlookPositive}}outlook-bullish{{else}}outlook-bearish{{/if}}">{{this.outlook_signal}}</div>
                        <div class="price">Close: ${{this.last_close_formatted}}</div>
                    </div>
                </div>
                {{/each}}
                 <div style="text-align: center; margin-top: 30px;">
                    <a href="https://profitscout.app/dashboard" class="cta-button">Explore All Setups</a>
                </div>
            {{else}}
                <p>No new top setups were identified today. The market may be consolidating. Check the dashboard for existing signals.</p>
            {{/if}}
        </div>

        <div class="footer">
            <p>You are receiving this email because you signed up for ProfitScout. Not financial advice.</p>
            <p>&copy; {{#if (new Date().getFullYear)}}{{else}}{{/if}} ProfitScout. All rights reserved. | <a href="https://profitscout.app/terms">Terms of Service</a></p>
        </div>
    </div>
</body>
</html>
